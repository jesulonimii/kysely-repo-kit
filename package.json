{
  "name": "kysely-repo-kit",
  "version": "0.4.1",
  "description": "Typed repository and populate layer for Kysely",
  "repository": "https://github.com/jesulonimii/kysely-repo-kit",
  "type": "module",
  "author": "jesulonimii",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p test",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "kysely": "^0.28.17"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "kysely": "^0.28.17",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
